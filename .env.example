# From @BotFather. Required.
BOT_TOKEN=

# Who may use the bot. BOTH EMPTY (the default) means any user in any chat can use
# it — add the bot to a group and it just works, no configuration. In that mode
# RATE_LIMIT_PER_HOUR below is the only brake on abuse.
#
# To restrict it instead, fill in either list; access is granted by EITHER.
# ALLOWED_USER_IDS: specific people, in any chat. Get your ID from @userinfobot.
# ALLOWED_CHAT_IDS: whole chats — anyone in these groups may use it. Group IDs are
#   negative (e.g. -1001234567890). Send /chatid in the chat to get it.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# Who may run /stats, /errors and /health. These fail closed: with this empty,
# nobody can run them, because the bot itself may be open to everyone.
ADMIN_USER_IDS=

# Where alerts about new failures are sent. Defaults to the admin above when
# there is exactly one, so this is usually left empty. Set it to a private
# group id if you would rather alerts went there.
ALERT_CHAT_ID=

# Clips longer than this are refused before anything is downloaded.
MAX_DURATION_SECONDS=300

# Telegram caps bot uploads at 50 MB; values above 50 are clamped to 50.
MAX_FILESIZE_MB=50

# Downloads are I/O-bound on the platforms' APIs, so a few at once is cheap.
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_ATTEMPTS=3

# Re-encoding is the one CPU-heavy operation; two at once will bury a Pi.
MAX_CONCURRENT_TRANSCODES=1

# --- pacing, against ceilings that cannot be raised ---
# Telegram allows roughly 20 messages a minute into one chat. 3s stays clear of
# that without being noticeable. 0 disables.
CHAT_SEND_INTERVAL_SECONDS=3

# Minimum gap between requests to the same platform. Sites throttle by IP, and a
# home IP is a scarce resource. 0 disables spacing (a throttle cooldown still applies).
PLATFORM_INTERVAL_SECONDS=2

# How long to leave a platform alone after it throttles us. 0 disables.
PLATFORM_COOLDOWN_SECONDS=60

# --- floors, so the bot never takes the machine down with it ---
# Work is refused rather than started when the machine is below these. 0 disables.
MIN_FREE_DISK_MB=500
MIN_FREE_MEMORY_MB=200

# How long a sent clip stays re-sendable from cache. After this it is downloaded
# again, so the bot stops serving posts that have since been deleted. 0 = never expire.
CACHE_TTL_DAYS=30

# How long per-request events are kept for /stats. Unique errors are kept
# regardless: they are small and they are the history worth having.
STATS_RETENTION_DAYS=90

# Salt for hashing chat and user ids in the event log. Defaults to the bot
# token, which is stable and already secret. Set it to rotate the hashes.
EVENT_SALT=

# Downloads allowed per user per hour. 0 disables the limit.
RATE_LIMIT_PER_HOUR=30

# Where the file_id cache lives. /data in Docker, ./data when run directly.
DATA_DIR=data

# Optional Netscape-format cookies file. Instagram sometimes needs one,
# and any datacenter host will need one more often than the Pi does.
COOKIES_FILE=

# Health endpoint port. Free hosts that require a bound port expect 7860 (HF) or $PORT.
PORT=7860

# Interface for the health endpoint. Containers need 0.0.0.0 so the host can reach it.
# On a home LAN set 127.0.0.1 to keep it off the network entirely.
HEALTH_HOST=0.0.0.0

# --- knowing the bot is alive ---
# Alerts only work while the bot is running. If the machine loses power or the
# internet drops, nothing reports it. Point this at a dead-man's-switch service
# (Healthchecks.io, Better Stack, cron-job.org - all have free tiers): the bot
# pings it on a schedule and the service emails you when the pings stop.
# Outbound only, so nothing is exposed. Leave empty to disable.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=300

# Warn this many days before the Instagram session expires. Read from the
# cookie file's own expiry dates, not from how old the file is.
COOKIE_WARN_DAYS=14

LOG_LEVEL=INFO
